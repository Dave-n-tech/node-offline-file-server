<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>FileShare</title>
  <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="flex flex-col items-center justify-center min-h-screen bg-gray-100">
  <h1 class="text-3xl font-bold mb-4">Connect to FileShare</h1>
  <div class="mb-4">
    <img src="<%= qrDataURL %>" alt="Scan QR to connect" class="border p-2 bg-white">
  </div>
  <!-- <p class="mb-2">Laptop/Desktop: <strong><%= mdnsName %>:8080</strong></p> -->
  <p class="mb-8">Fallback IP: <strong>http://<%= LAN_IP %>:8080</strong></p>
  <a href="/upload" class="mt-18 inline-block bg-blue-500 text-white px-6 py-6 rounded-lg hover:bg-blue-600 active:bg-blue-700 transition-colors font-medium shadow-sm hover:shadow-md">
    Upload Files
  </a>
</body>
</html>